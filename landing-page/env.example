# Leave empty to use same-origin /api proxy (recommended for local dev — see next.config.ts)
# NEXT_PUBLIC_API_BASE_URL=

# Server-side proxy target (must match tradingSignals server PORT)
API_PROXY_TARGET=http://localhost:5001

# Public site URL (sitemap, robots) — Next.js dev default port
NEXT_PUBLIC_SITE_URL=http://localhost:3001
