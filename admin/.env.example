# Local dev — Vite proxies /api → VITE_API_PROXY_TARGET (run: cd server && npm run dev)
VITE_API_BASE_URL=/api
# Must match tradingSignals/server PORT (check server/.env)
VITE_API_PROXY_TARGET=http://localhost:5000
VITE_BLOG_PUBLIC_URL=https://www.tradingsignals.ai

