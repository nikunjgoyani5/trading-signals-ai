NODE_ENV=development
PORT=5001
API_PUBLIC_URL=http://localhost:5001
# Comma-separated allowed origins (landing page + admin)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:5173
CLIENT_URL=http://localhost:5173
LANDING_PAGE_URL=http://localhost:3001

# Required for forgot-password emails (Brevo)
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=your-verified-sender@example.com

DB_URI=mongodb://127.0.0.1:27017/trading-signal-admin

JWT_ACCESS_SECRET=change-this-access-secret-min-16-chars
JWT_REFRESH_SECRET=change-this-refresh-secret-min-16-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REMEMBER_REFRESH_EXPIRES_IN=30d

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Admin

# Optional — required for POST /api/generate-blog and /api/generate-image
OPENAI_API_KEY=
# Tries dall-e-3 first (browser temp URL), then dall-e-2, then gpt-image-1 (local temp preview)
# OPENAI_IMAGE_MODEL=dall-e-3
# AI cover generations allowed per blog (3–5, default 3)
# MAX_BLOG_AI_COVER_GENERATIONS=3

# Required for blog cover upload on save (POST/PUT /api/blogs)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Brevo — password reset emails (POST /api/auth/forgot-password)
# Create an API key at https://app.brevo.com/settings/keys/api
# BREVO_SENDER_EMAIL must match a verified sender at https://app.brevo.com/senders
# For Vercel/serverless: disable "Authorized IPs" at https://app.brevo.com/security/authorised_ips
# (Vercel uses changing IPs — IP allowlist will cause 401 in production)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=your-verified-sender@example.com
BREVO_SENDER_NAME=Trading Signals

# volumeDayTraders-compatible Brevo config (email|xkeysib-... or email|xsmtpsib-...)
# BREVO_SMTP_KEY=your-verified@email.com|xkeysib-your-api-key

# Contact form — all new inquiries are sent here
INQUIRY_NOTIFY_EMAIL=tradingsignals@yopmail.com

# yopmail / disposable inboxes — use Gmail SMTP (Google App Password, 16 chars)
# https://myaccount.google.com/apppasswords
GMAIL_USER=your-verified@gmail.com
GMAIL_APP_PASSWORD=your-google-app-password
EMAIL_USE_GMAIL_FOR_DISPOSABLE=true
